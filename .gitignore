# macOS
.DS_Store

# Videos (too large for GitHub — host separately)
videos/

# Blog: public post sources ARE committed (blog-src/posts/) so drafts get git
# history. Only the encrypted posts' plaintext is kept out of the repo.
blog-src/private/
blog-src/.slug-salt

# Full pre-rewrite git backup (restore: git clone .git-backup-pre-rewrite.bundle)
.git-backup-pre-rewrite.bundle

# Loose working files dropped in the repo ROOT (screenshots, documents). These
# are never part of the site, and this repo is public. Anchored with a leading
# slash so a deliberate images/Screenshot-*.png still works.
/Screenshot*.png
/*.docx
/*.pages
/*.key
/*.numbers
